@echo off
rem Keep batch files ASCII-only; user-facing text here intentionally uses ASCII.
setlocal
title VoiceSculptor Diagnostics
set "ROOT=%~dp0"
set "ENG=%ROOT%engine\CosyVoice"
set "MODEL=%ENG%\pretrained_models\Fun-CosyVoice3-0.5B"
if defined COSYVOICE_MODEL_DIR set "MODEL=%COSYVOICE_MODEL_DIR:"=%"
if "%MODEL:~-1%"=="\" set "MODEL=%MODEL:~0,-1%"
if "%MODEL:~-1%"=="/" set "MODEL=%MODEL:~0,-1%"
set "PYTHONUTF8=1"
set "PYTHONIOENCODING=utf-8"
set "REPORT=%ROOT%logs\diagnostic-report.txt"
if not exist "%ROOT%logs" mkdir "%ROOT%logs"

echo Collecting diagnostics. The first uv sync may take several minutes...
> "%REPORT%" echo ===== VoiceSculptor Diagnostic Report =====
>> "%REPORT%" echo Generated by the Diagnostics launcher.
>> "%REPORT%" echo Root: "%ROOT%"
>> "%REPORT%" echo Model dir: "%MODEL%"
if defined COSYVOICE_MODEL_DIR (>> "%REPORT%" echo COSYVOICE_MODEL_DIR is set) else (>> "%REPORT%" echo COSYVOICE_MODEL_DIR is not set, using default)
>> "%REPORT%" echo.

>> "%REPORT%" echo ---- Operating system ----
ver >> "%REPORT%" 2>&1
powershell -NoProfile -Command "[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-CimInstance Win32_OperatingSystem | Select-Object Caption,Version,OSArchitecture,TotalVisibleMemorySize,FreePhysicalMemory | Format-List" >> "%REPORT%" 2>&1

>> "%REPORT%" echo.
>> "%REPORT%" echo ---- GPU and driver ----
where nvidia-smi >nul 2>nul
if errorlevel 1 (
  >> "%REPORT%" echo [WARN] nvidia-smi not found. NVIDIA driver or GPU may be unavailable.
) else (
  powershell -NoProfile -Command "[Console]::OutputEncoding=[Text.Encoding]::UTF8; nvidia-smi --query-gpu=name,driver_version,memory.total,memory.used --format=csv" >> "%REPORT%" 2>&1
  powershell -NoProfile -Command "[Console]::OutputEncoding=[Text.Encoding]::UTF8; nvidia-smi | Select-String 'CUDA Version'" >> "%REPORT%" 2>&1
)

>> "%REPORT%" echo.
>> "%REPORT%" echo ---- Disk space ----
powershell -NoProfile -Command "[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-CimInstance Win32_LogicalDisk | Select-Object DeviceID,@{n='FreeGB';e={[math]::Round($_.FreeSpace/1GB,1)}},@{n='TotalGB';e={[math]::Round($_.Size/1GB,1)}} | Format-Table" >> "%REPORT%" 2>&1

>> "%REPORT%" echo.
>> "%REPORT%" echo ---- uv and required files ----
where uv >nul 2>nul
if errorlevel 1 ( >> "%REPORT%" echo [MISSING] uv. Install with: winget install astral-sh.uv ) else ( >> "%REPORT%" echo [OK] uv )
for %%F in ("%ENG%\runtime\python\fastapi\server.py" "%ROOT%app\app.py" "%MODEL%\llm.pt" "%MODEL%\flow.pt" "%MODEL%\hift.pt" "%MODEL%\campplus.onnx" "%MODEL%\speech_tokenizer_v3.onnx" "%MODEL%\CosyVoice-BlankEN\model.safetensors") do (
  if exist %%F ( >> "%REPORT%" echo [OK]   %%~fF ) else ( >> "%REPORT%" echo [MISSING] %%~fF )
)
for %%F in ("%MODEL%\cosyvoice3.yaml" "%MODEL%\config.json") do (
  if exist %%F ( >> "%REPORT%" echo [OK]   %%~fF ) else ( >> "%REPORT%" echo [WARN] optional file not found: %%~fF )
)

>> "%REPORT%" echo.
>> "%REPORT%" echo ---- Python and CUDA self-check (via uv) ----
cd /d "%ENG%" 2>nul
if errorlevel 1 (
  >> "%REPORT%" echo [ERROR] Engine directory not found: "%ENG%"
) else (
  uv run python "%ROOT%_selfcheck.py" >> "%REPORT%" 2>&1
)

>> "%REPORT%" echo.
>> "%REPORT%" echo ---- Port usage ----
powershell -NoProfile -Command "[Console]::OutputEncoding=[Text.Encoding]::UTF8; netstat -ano | Select-String -Pattern ':50000\s',':50001\s',':8091\s'" >> "%REPORT%" 2>&1

>> "%REPORT%" echo.
>> "%REPORT%" echo ---- Engine log (last 40 lines) ----
if exist "%ROOT%logs\engine.log" (
  set "VS_TAIL=%ROOT%logs\engine.log"
  powershell -NoProfile -Command "[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-Content -LiteralPath $env:VS_TAIL -Encoding UTF8 -Tail 40" >> "%REPORT%" 2>&1
) else (
  >> "%REPORT%" echo [INFO] engine.log not found.
)

>> "%REPORT%" echo.
>> "%REPORT%" echo ---- App log (last 40 lines) ----
if exist "%ROOT%logs\app.log" (
  set "VS_TAIL=%ROOT%logs\app.log"
  powershell -NoProfile -Command "[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-Content -LiteralPath $env:VS_TAIL -Encoding UTF8 -Tail 40" >> "%REPORT%" 2>&1
) else (
  >> "%REPORT%" echo [INFO] app.log not found.
)

echo.
echo Diagnostics complete: "%REPORT%"
echo Send this report when requesting support.
echo.
pause
