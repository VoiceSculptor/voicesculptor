# Windows cmd.exe batch sources are ASCII-only so they work with any active code page.
# Keep CRLF in the working tree; Git normalizes these files in the repository.
*.cmd    text eol=crlf
*.bat    text eol=crlf

# 其余纯文本按默认处理（git 自动识别，Windows 下检出时为 CRLF）
*        text=auto

# 二进制格式明确声明，避免 git 误判
*.wav    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.pt     binary
*.onnx   binary
