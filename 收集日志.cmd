@echo off
rem Keep batch files ASCII-only; user-facing text here intentionally uses ASCII.
setlocal
title VoiceSculptor Log Collector
set "ROOT=%~dp0"
set "OUT=%ROOT%logs_bundle.zip"
if not exist "%ROOT%logs" mkdir "%ROOT%logs"
if exist "%OUT%" del /f /q "%OUT%"

echo Collecting environment information...
> "%ROOT%logs\collection.txt" echo Generated by the Log Collector.
>> "%ROOT%logs\collection.txt" echo Root: "%ROOT%"
uv --version >> "%ROOT%logs\collection.txt" 2>&1
git -C "%ROOT%." rev-parse --short HEAD >> "%ROOT%logs\collection.txt" 2>&1
git -C "%ROOT%engine\CosyVoice" rev-parse --short HEAD >> "%ROOT%logs\collection.txt" 2>&1

echo Creating log archive...
set "VS_LOGS=%ROOT%logs"
set "VS_OUT=%OUT%"
powershell -NoProfile -ExecutionPolicy Bypass -Command "if (Test-Path -LiteralPath $env:VS_LOGS) { Get-ChildItem -LiteralPath $env:VS_LOGS | Compress-Archive -DestinationPath $env:VS_OUT -Force }"
if errorlevel 1 (
  echo.
  echo [ERROR] Could not create the archive. Check disk space and close any program using the zip file.
)

if exist "%OUT%" (
  echo.
  echo Archive created: "%OUT%"
  echo Send this file when requesting support.
) else (
  echo.
  echo [INFO] No archive was created. Run the Diagnostics launcher first.
)
echo.
pause
